# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# C/C++ files
[*.{c,h,cpp,hpp}]
indent_style = space
indent_size = 2
tab_width = 2

# CMake files
[*.{cmake,CMakeLists.txt}]
indent_style = space
indent_size = 4
tab_width = 4
